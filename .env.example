# ==========================================
# CineMate 🍿 Environment Variables
# ==========================================

# (Optional) Supabase Realtime Configuration
# If omitted, CineMate automatically uses local multi-tab BroadcastChannel
# for instant testing without requiring an external backend.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# (Optional) WebRTC STUN & TURN Configuration
# Free Google STUN servers are already built-in by default.
VITE_STUN_SERVER=stun:stun.l.google.com:19302
VITE_TURN_SERVER=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
