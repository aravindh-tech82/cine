# ==========================================
# CineMate 🍿 Production Environment Variables
# ==========================================

# 1. Supabase Realtime Configuration (REQUIRED for Cross-Device Production)
# Create a free project at https://supabase.com
# Go to Project Settings -> API -> Project URL & Project API Keys (anon / public)
VITE_SUPABASE_URL=https://fbbiqkutqbbwduztqczv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_MKq8FyPvotlCe6eH1rlKpw_g4QxKD4l

# 2. WebRTC STUN Server
# Default Google STUN server is built-in; override if needed:
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# 3. WebRTC TURN Server (RECOMMENDED for Symmetric NAT / 4G / 5G Mobile Traversal)
# Free TURN credentials available at: https://www.metered.ca/tools/openrelay/
# Or use your own Coturn / Twilio Network Traversal credentials.
# Supports single URL or comma-separated list of transport URLs:
VITE_TURN_SERVER=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443,turn:openrelay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=openrelayproject
VITE_TURN_CREDENTIAL=openrelayproject

# (Alternative) Full ICE Servers JSON array:
# VITE_ICE_SERVERS='[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:relay.example.com:443"],"username":"user","credential":"pwd"}]'
